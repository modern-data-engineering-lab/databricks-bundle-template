# Copy this file to terraform.tfvars (gitignored) and fill in your own values.
# terraform.tfvars is never committed — that's what keeps it safe to put real values in it.

databricks_cli_profile = "weather-app" # or null to use env vars instead

github_owner      = "your-github-org-or-username"
github_repository = "databricks-bundle-template"

# Get your own numeric GitHub user ID with: gh api user -q .id
# Leave null (or delete this line) to skip the required-reviewer gate on production.
production_approver_github_user_id = 12345678

# Leave false (the default) to keep GitHub secrets a manual `gh secret set` step — see
# variables.tf for why. Only set true if your Terraform state backend is itself encrypted
# and access-controlled.
manage_github_secrets_with_terraform = false

# Only needed if manage_github_secrets_with_terraform = true above.
# databricks_host = "https://dbc-xxxxxxxx-xxxx.cloud.databricks.com"
